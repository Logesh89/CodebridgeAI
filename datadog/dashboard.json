{
  "title": "SnapLogic Platform Monitoring",
  "description": "Monitoring dashboard for SnapLogic to Python conversion platform",
  "widgets": [
    {
      "definition": {
        "title": "Conversion Success Rate",
        "type": "timeseries",
        "requests": [{"q": "sum:conversion.success{*}.as_count()"}]
      }
    },
    {
      "definition": {
        "title": "Conversion Failure Rate",
        "type": "timeseries",
        "requests": [{"q": "sum:conversion.failed{*}.as_count()"}]
      }
    },
    {
      "definition": {
        "title": "API Response Time",
        "type": "timeseries",
        "requests": [{"q": "avg:trace.fastapi.request.duration{*}"}]
      }
    },
    {
      "definition": {
        "title": "Pipeline Execution Time",
        "type": "timeseries",
        "requests": [{"q": "avg:pipeline.execution.time{*}"}]
      }
    },
    {
      "definition": {
        "title": "CPU Usage",
        "type": "timeseries",
        "requests": [{"q": "avg:system.cpu.user{*}"}]
      }
    },
    {
      "definition": {
        "title": "Memory Usage",
        "type": "timeseries",
        "requests": [{"q": "avg:system.mem.used{*}"}]
      }
    }
  ]
}
