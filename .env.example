# Application
APP_NAME=SnapLogic to Python AI Conversion Platform
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-secure-random-string
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
POSTGRES_USER=snaplogic_user
POSTGRES_PASSWORD=snaplogic_pass
POSTGRES_DB=snaplogic_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://snaplogic_user:snaplogic_pass@postgres:5432/snaplogic_platform

# JWT
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_TIMEOUT_MINUTES=60

# OTP
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@snaplogic-platform.com
SMTP_TLS=true

# SnapLogic
SNAPLOGIC_BASE_URL=https://elastic.snaplogic.com
SNAPLOGIC_USERNAME=
SNAPLOGIC_PASSWORD=
SNAPLOGIC_ORG=
SNAPLOGIC_RETRY_ATTEMPTS=3
SNAPLOGIC_RETRY_DELAY=5

# AI Conversion
OPENAI_API_KEY=
AI_MODEL=gpt-4o
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.1

# Storage Paths
UPLOAD_DIR=uploads
SNAPLOGIC_JSON_DIR=snaplogic_json
GENERATED_DIR=generated
COMPLETED_DIR=completed
FAILED_DIR=failed
LOGS_DIR=logs
REPORTS_DIR=reports
TEMP_DIR=temp
DOWNLOADS_DIR=downloads

# Airflow
AIRFLOW_BASE_URL=http://airflow-webserver:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

# Datadog
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com
DD_SERVICE=snaplogic-platform
DD_ENV=development
DD_VERSION=1.0.0
DD_LOGS_INJECTION=true
DD_TRACE_ENABLED=true

# Redis
REDIS_URL=redis://redis:6379/0
